{
	"info": {
		"_postman_id": "prestamo-equipos-collection",
		"name": "Préstamo de Equipos Tecnológicos",
		"description": "Colección de pruebas para la API REST del Sistema de Préstamo de Equipos Tecnológicos.\n\nVariable {{baseUrl}} = http://localhost:3000",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "EQUIPOS",
			"item": [
				{
					"name": "01. GET Todos los equipos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/equipos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "equipos"]
						},
						"description": "Consultar todos los equipos registrados."
					}
				},
				{
					"name": "02. GET Equipo por ID (existente)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/equipos/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "equipos", "1"]
						},
						"description": "Consultar el equipo con ID 1."
					}
				},
				{
					"name": "03. POST Nuevo equipo",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Cámara Canon EOS R50\",\n    \"tipo\": \"Cámara\",\n    \"serial\": \"CANON-R50-007\",\n    \"estado\": \"DISPONIBLE\",\n    \"observacion\": \"Cámara para grabaciones de laboratorio\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/equipos",
							"host": ["{{baseUrl}}"],
							"path": ["api", "equipos"]
						},
						"description": "Registrar un nuevo equipo con todos los datos válidos."
					}
				},
				{
					"name": "04. PUT Actualizar equipo",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nombre\": \"Laptop Dell Latitude 5520 (Actualizada)\",\n    \"tipo\": \"Laptop\",\n    \"serial\": \"DLL-5520-001\",\n    \"estado\": \"DISPONIBLE\",\n    \"observacion\": \"Equipo actualizado con 32GB RAM\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/equipos/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "equipos", "1"]
						},
						"description": "Actualizar los datos del equipo con ID 1."
					}
				},
				{
					"name": "05. DELETE Eliminar equipo",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/equipos/7",
							"host": ["{{baseUrl}}"],
							"path": ["api", "equipos", "7"]
						},
						"description": "Eliminar el equipo con ID 7 (el que creamos en la prueba 03, si existe)."
					}
				}
			],
			"description": "Endpoints CRUD de equipos."
		},
		{
