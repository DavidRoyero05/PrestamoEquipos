							"raw": "{\n    \"equipo_id\": 2,\n    \"responsable\": \"Ana López\",\n    \"identificacion\": \"1023456789\",\n    \"fecha_prestamo\": \"2026-09-07\",\n    \"fecha_devolucion_prevista\": \"2026-09-14\"\n}"
